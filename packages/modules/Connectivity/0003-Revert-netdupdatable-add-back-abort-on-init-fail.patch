From 1a610273c655a820b2530c8213a1fdc6b8592eca Mon Sep 17 00:00:00 2001
From: Alberto Ponces <ponces26@gmail.com>
Date: Thu, 20 Jun 2024 12:38:58 +0100
Subject: [PATCH] Revert "netdupdatable: add back abort() on init() fail"

This reverts commit ff845a642bc988f960c77ac60664560f8cdc7ee3.
---
 bpf/netd/NetdUpdatable.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/bpf/netd/NetdUpdatable.cpp b/bpf/netd/NetdUpdatable.cpp
index 8b2b4dc..141bf4a 100644
--- a/bpf/netd/NetdUpdatable.cpp
+++ b/bpf/netd/NetdUpdatable.cpp
@@ -18,6 +18,8 @@
 
 #include "BpfHandler.h"
 
+#include <errno.h>
+
 #include <android-base/logging.h>
 #include <android-base/result.h>
 
@@ -32,7 +34,8 @@ int libnetd_updatable_init(const char* cg2_path) {
     android::base::Result<void> ret = sBpfHandler.init(cg2_path);
     if (!ret.ok()) {
         LOG(ERROR) << __func__ << ": Failed: " << ret.error().message();
-        abort();
+        const int code = ret.error().code();
+        return code ? -code : -EIO;
     }
     return 0;
 }
