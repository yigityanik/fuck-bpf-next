From b4562362efb4c148af94868929dbce4e76c93321 Mon Sep 17 00:00:00 2001
From: Codex <codex@local.invalid>
Date: Tue, 6 Oct 2026 16:21:04 +0300
Subject: [PATCH] core: port legacy kernel BPF compatibility to LineageOS 24.0

Adapted from techyminati/fuck-bpf lineage-23.2 (990553a).
Original contributor attribution and target revisions are listed in SOURCES.md and BASE_REVISIONS.json.
---
 libprocessgroup/setup/cgroup_map_write.cpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/libprocessgroup/setup/cgroup_map_write.cpp b/libprocessgroup/setup/cgroup_map_write.cpp
index 0b26e95..f497a8a 100644
--- a/libprocessgroup/setup/cgroup_map_write.cpp
+++ b/libprocessgroup/setup/cgroup_map_write.cpp
@@ -173,7 +173,7 @@ static bool ActivateV2CgroupController(const CgroupDescriptor& descriptor) {
 
     if (!Mkdir(controller->path(), descriptor.mode(), descriptor.uid(), descriptor.gid())) {
         LOG(ERROR) << "Failed to create directory for " << controller->name() << " cgroup";
-        return descriptor.controller()->flags() & CGROUPRC_CONTROLLER_FLAG_OPTIONAL;
+        return false;
     }
 
     return ::ActivateControllers(controller->path(), {{controller->name(), descriptor}});
@@ -290,8 +290,8 @@ bool CgroupSetup() {
         }
 
         if (!SetupCgroup(descriptor)) {
-            LOG(ERROR) << "Failed to setup " << name << " cgroup";
-            return false;
+            // issue a warning and proceed with the next cgroup
+            LOG(WARNING) << "Failed to setup " << name << " cgroup";
         }
     }
 
