From fe1b6115e1ca959d1babce8d3a029e1479d4e542 Mon Sep 17 00:00:00 2001
From: ChonDoit <thphantomblog@gmail.com>
Date: Fri, 7 Oct 2022 02:43:21 +0000
Subject: [PATCH] Support no-bpf usecase

Change-Id: Ic759e2cfaf11705169a4a6b677b0e5aca26907b3
---
 server/Controllers.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/server/Controllers.cpp b/server/Controllers.cpp
index 8a2c3be..7ad239b 100644
--- a/server/Controllers.cpp
+++ b/server/Controllers.cpp
@@ -335,7 +335,8 @@ void Controllers::init() {
         // As such simply exit netd.  This may crash loop the system, but by failing
         // to bootup we will trigger rollback and thus this offers us protection against
         // a mainline update breaking things.
-        exit(2);
+        // Legacy kernels may not provide the BPF accounting maps.
+        // Continue with the available networking functionality.
     }
     gLog.info("Enabling bandwidth control: %" PRId64 "us", s.getTimeAndResetUs());
 
