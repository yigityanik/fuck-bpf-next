From 4fddcaf49467068a0057d28a91b54a4ef6d25417 Mon Sep 17 00:00:00 2001
From: Pierre-Hugues Husson <phh@phh.me>
Date: Wed, 26 Oct 2022 18:13:56 -0400
Subject: [PATCH] Don't abort in case of cgroup/bpf setup fail, since some
 devices dont have BPF

---
 server/main.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/server/main.cpp b/server/main.cpp
index be9a1d0..c702b8a 100644
--- a/server/main.cpp
+++ b/server/main.cpp
@@ -142,12 +142,12 @@ int main(const int argc, const char* argv[]) {
     std::string cg2_path;
     if (!CgroupGetControllerPath(CGROUPV2_HIERARCHY_NAME, &cg2_path)) {
         ALOGE("Failed to find cgroup v2 root %s", strerror(errno));
-        exit(1);
+        cg2_path = "/sys/fs/cgroup";
     }
 
     if (libnetd_updatable_init(cg2_path.c_str())) {
         ALOGE("libnetd_updatable_init failed");
-        exit(1);
+        //exit(1);
     }
     gLog.info("libnetd_updatable_init success");
 
